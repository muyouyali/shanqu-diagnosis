# ============================================
# 云岭农诊 · AI 服务配置
# ============================================
# 本系统采用 OpenAI 兼容协议的统一适配层，
# 切换服务商只需修改下面 4 项配置，无需改动任何代码。
#
# 【配置示例】
#
# ① 阿里云百炼（推荐，有免费额度）
#   AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   AI_VISION_MODEL=qwen-vl-max
#   AI_TEXT_MODEL=qwen-plus
#
# ② 字节火山方舟
#   AI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
#   AI_VISION_MODEL=ep-20241xxxxxx-vision
#   AI_TEXT_MODEL=ep-20241xxxxxx-text
#
# ③ 智谱 GLM
#   AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
#   AI_VISION_MODEL=glm-4v-plus
#   AI_TEXT_MODEL=glm-4-plus
#
# ④ DeepSeek（文本） + 其他视觉模型组合
#   AI_BASE_URL=https://api.deepseek.com/v1
#   AI_TEXT_MODEL=deepseek-chat
#
# ⑤ OpenAI
#   AI_BASE_URL=https://api.openai.com/v1
#   AI_VISION_MODEL=gpt-4o
#   AI_TEXT_MODEL=gpt-4o-mini
# ============================================

AI_BASE_URL=
AI_API_KEY=
AI_VISION_MODEL=
AI_TEXT_MODEL=

# 超时（毫秒），网络不佳时可调大
AI_TIMEOUT_MS=45000

# 失败重试次数
AI_MAX_RETRIES=2

# 采样温度（诊断场景建议 0.2-0.4，保证稳定）
AI_TEMPERATURE=0.3

# 服务端口
PORT=3001

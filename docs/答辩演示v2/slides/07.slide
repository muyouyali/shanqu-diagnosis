<Slide style={{ width: 1280, height: 720, background: '#f6faf7', padding: '48px 60px' }}>
  <Text style={{ fontSize: 30, fontWeight: 'bold', color: '#0f3d22' }}>创新性：一句话说清和它们的区别</Text>
  <Box style={{ background: '#fff', borderRadius: 14, border: '1px solid #e2ece5', marginTop: 24 }}>
    <Box style={{ flexDirection: 'row', background: '#0f3d22', borderRadius: '14px 14px 0 0' }}>
      {['', '拍照识虫类小程序', '通用大模型直接问', '云岭农诊'].map((h, i) => (
        <Box style={{ flex: i === 0 ? 0.6 : 1, padding: '12px 14px' }}>
          <Text style={{ fontSize: 13.5, fontWeight: 'bold', color: '#fff' }}>{h}</Text>
        </Box>
      ))}
    </Box>
    {[
      ['识别后输出', '仅病害名', '泛泛建议', '三级诊疗报告（诊断+闸门+用药），全程留痕'],
      ['知识来源', '封闭模型无法审计', '模型幻觉风险', '自研 RAG 知识库，方案带来源与安全间隔期'],
      ['用药安全', '无校验', '可能推荐禁用药', '禁药黑名单硬拦截 + 安全间隔期强制提示'],
      ['服务闭环', '无', '无', '低置信自动转农技站人工复核 + 区域预警']
    ].map((row, ri) => (
      <Box style={{ flexDirection: 'row', background: ri % 2 ? '#f4faf6' : '#fff' }}>
        {row.map((cell, ci) => (
          <Box style={{ flex: ci === 0 ? 0.6 : 1, padding: '11px 14px', borderTop: '1px solid #e2ece5' }}>
            <Text style={{ fontSize: 12, color: ci === 3 ? '#14532d' : '#374151', fontWeight: ci === 0 || ci === 3 ? 'bold' : 'normal', lineHeight: 1.6 }}>{ci === 3 ? '✅ ' : ''}{cell}</Text>
          </Box>
        ))}
      </Box>
    ))}
  </Box>
  <Box style={{ background: '#0f2a1a', borderRadius: 12, padding: '16px 20px', marginTop: 20 }}>
    <Text style={{ fontSize: 14.5, color: '#d5ecd9', lineHeight: 1.8 }}>
      <span style={{ color: '#ffd9a0', fontWeight: 'bold' }}>一句话差异：</span>竞品输出「识别结果」，我们输出「<span style={{ fontWeight: 'bold' }}>可追责的诊疗决策链路</span>」——每一步 Agent 做了什么、为什么拦截、依据哪条知识库，全部可视化。创新落在选题（山地特色作物+安全兜底）、技术方案（确定性闸门+FC 工具）、交互模式（Agent 轨迹可视化+图文速查）三个层面。
    </Text>
  </Box>
</Slide>
